{
  "expo": {
    "name": "CityVetHub",
    "slug": "cityvethub-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cityvethub.iligan"
    },
    "android": {
      "package": "com.cityvethub.iligan",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#00AEEF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CityVetHub to access your camera to scan Pet Digital Passport QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CityVetHub to access your photos to upload pet pictures, health cards, incident evidence, and verification IDs."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f3b8d659-8f2a-44be-acb6-a4d5b975962d"
      }
    }
  }
}
